# Cloudflare Pages response headers
# CSP allows Google Analytics and Cloudflare Web Analytics (beacon auto-injected on the zone)
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Fingerprinted build output never changes, so cache it for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Must always be revalidated so app updates are picked up
/sw.js
  Cache-Control: no-cache
/sw-notifications.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
